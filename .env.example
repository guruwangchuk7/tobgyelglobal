# ============================================================================
# Environment variables for Tobgyel Global Expos
# Copy to .env.local and fill in real values. .env* is gitignored.
# ============================================================================

# --- Supabase (required) ---
# Public values (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server-only. Used by the API routes for all privileged DB access.
# Never expose this to the client. Rotate if it has ever been committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin panel authentication (optional; defaults shown) ---
# If unset, the panel falls back to admin / admin123. SET THESE IN PRODUCTION.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# Secret used to sign the admin session cookie (HMAC). If unset it derives from
# SUPABASE_SERVICE_ROLE_KEY. Set an independent high-entropy value in production.
ADMIN_SESSION_SECRET=generate-a-long-random-string

# --- Contact form email delivery (optional) ---
# Where contact inquiries are emailed (falls back to info@tobgyelglobalxpos.com):
OWNER_EMAIL=info@tobgyelglobalxpos.com
# Optional Web3Forms fallback delivery. If unset, that fallback is skipped.
WEB3FORMS_ACCESS_KEY=

# --- SEO / analytics (optional, public) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
